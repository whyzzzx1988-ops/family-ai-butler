# 全家管家生产环境变量模板：复制为 .env 后填真实值。
# .env 已被 .gitignore 排除，绝不要提交真实密钥；本模板只留变量名。

# 数据库密码（同时用作 compose 里 Postgres 的密码与后端连接密码，部署前改掉默认值）
DB_PASSWORD=

# DeepSeek 官方 API Key（纪要/学习加工/模型账；不填则相关接口 503 明示）
DEEPSEEK_API_KEY=

# 阿里云百炼 DashScope API Key（语音转写 Paraformer；不填则语音只存不转写）
DASHSCOPE_API_KEY=

# 微信小程序（公众平台 → 开发管理 → 开发设置 里获取）
WECHAT_APPID=
WECHAT_SECRET=

# 订阅消息模板 ID（公众平台 → 功能 → 订阅消息 申请，字段统一用 thing1 + date2）
# 晨报/睡眠周报推送
WECHAT_TEMPLATE_BRIEFING_ID=
# 复习提醒推送
WECHAT_TEMPLATE_REVIEW_ID=
# 用药按点推送
WECHAT_TEMPLATE_MEDICATION_ID=
# 待办到期推送
WECHAT_TEMPLATE_TODO_ID=
