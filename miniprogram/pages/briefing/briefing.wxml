<view class="container">
  <view class="orbit-hero">
    <view class="orbit-ring">
      <view class="orbit-core"></view>
      <view class="orbit-planet"></view>
      <view class="orbit-sat"></view>
    </view>
    <view class="orbit-caption">深 空 巡 星 · 为 全 家 值 守</view>
  </view>

  <view class="title">{{date}} 全家简报</view>

  <view wx:if="{{loading}}" class="muted">加载中…</view>

  <view wx:elif="{{lines}}" class="card">
    <view wx:for="{{lines}}" wx:key="index" class="line {{item.cls}}">{{item.text}}</view>
    <view class="speech-bar">
      <button class="btn-primary speech-btn" loading="{{speechState === 'loading'}}" bindtap="toggleSpeech">{{speechLabel}}</button>
      <button wx:if="{{speechState === 'playing' || speechState === 'paused' || speechState === 'loading'}}" class="btn-ghost speech-btn" bindtap="stopSpeech">停止</button>
    </view>
    <view wx:if="{{speechHint}}" class="muted" style="margin-top: 10rpx;">{{speechHint}}</view>
  </view>

  <view wx:else class="card">
    <view class="muted" style="margin-bottom: 16rpx;">今天的简报还没生成。</view>
    <button class="btn-primary" loading="{{generating}}" bindtap="generate">生成今日简报</button>
  </view>

  <button class="btn-ghost" bindtap="subscribe">订阅晨报提醒</button>
  <button class="btn-ghost" bindtap="subscribeMore" style="margin-top: 12rpx;">订阅用药 / 待办提醒</button>
  <view class="muted" style="margin-top: 12rpx;">定时简报由后端每天 07:00 自动生成；订阅消息需先在公众平台申请模板并配置模板 ID。复习提醒的订阅在「学习」页。</view>
</view>
