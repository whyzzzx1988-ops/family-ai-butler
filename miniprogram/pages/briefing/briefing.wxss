/* 轨道装饰（v2 展示层）：轨道环缓旋，核心行星静置发光 */
.orbit-hero {
  padding: 20rpx 0 4rpx;
}
.orbit-ring {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  margin: 0 auto;
  border: 1rpx solid rgba(255, 197, 49, 0.35);
  border-radius: 50%;
  animation: orbit-spin 16s linear infinite;
}
.orbit-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 64rpx;
  height: 64rpx;
  margin-left: -32rpx;
  margin-top: -32rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #FFE082, #FFB300 70%, #C78F00);
  box-shadow: 0 0 36rpx rgba(255, 184, 0, 0.55);
}
.orbit-planet {
  position: absolute;
  top: -11rpx;
  left: 50%;
  margin-left: -11rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #B9D2FF, #4A6FA5);
  box-shadow: 0 0 14rpx rgba(120, 160, 255, 0.8);
}
.orbit-sat {
  position: absolute;
  bottom: 22rpx;
  left: 16rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #F4F1E6;
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.8);
}
.orbit-caption {
  margin-top: 16rpx;
  text-align: center;
  color: #98A2B8;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}
@keyframes orbit-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.line {
  line-height: 1.7;
  word-break: break-all;
  color: #E9E6DA;
}
.h1 {
  color: #FFC531;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  margin: 8rpx 0;
}
.h {
  color: #FFE082;
  font-size: 32rpx;
  font-weight: 600;
  margin: 16rpx 0 6rpx;
}
.speech-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.speech-btn {
  flex: 1;
}
.speech-dots {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}
.sdot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}
.sdot.done {
  background: #FFC531;
  box-shadow: 0 0 8rpx rgba(255, 197, 49, 0.6);
}
.sdot.now {
  background: #FFC531;
  box-shadow: 0 0 10rpx rgba(255, 197, 49, 0.9);
  animation: sdot-pulse 1.1s ease-in-out infinite alternate;
}
@keyframes sdot-pulse {
  from { transform: scale(1); opacity: 0.75; }
  to { transform: scale(1.45); opacity: 1; }
}
