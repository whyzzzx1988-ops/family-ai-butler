.input {
  width: 100%;
  min-height: 160rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  color: #F4F1E6;
}
.collect-note {
  color: #FFC531;
  font-size: 25rpx;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
  animation: collect-glow 1.4s ease;
}
@keyframes collect-glow {
  0% { opacity: 0; text-shadow: 0 0 0 rgba(255, 197, 49, 0); }
  40% { opacity: 1; text-shadow: 0 0 18rpx rgba(255, 197, 49, 0.95); }
  100% { opacity: 1; text-shadow: 0 0 6rpx rgba(255, 197, 49, 0.4); }
}
.btn-recording {
  background: linear-gradient(135deg, #FF7A59, #E5484D);
  color: #ffffff;
  border-radius: 999rpx;
  box-shadow: 0 0 0 8rpx rgba(229, 72, 77, 0.16), 0 10rpx 24rpx rgba(229, 72, 77, 0.35);
}
.btn-recording:active {
  transform: scale(0.98);
}
.row {
  display: flex;
  gap: 16rpx;
}
.small {
  flex: 1;
  font-size: 28rpx;
}
