.brand {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #FFF8E1;
  text-shadow: 0 0 28rpx rgba(255, 197, 49, 0.35);
  margin: 60rpx 0 12rpx;
}
.field {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  color: #F4F1E6;
}
