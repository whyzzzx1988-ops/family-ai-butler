.rowline {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
}
.tag {
  background: rgba(255, 197, 49, 0.14);
  color: #FFC531;
  border: 1rpx solid rgba(255, 197, 49, 0.25);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  font-size: 24rpx;
  white-space: nowrap;
}
.flex {
  flex: 1;
}
.row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.chip {
  font-size: 26rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.05);
  color: #C7CEDD;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}
.chip.on {
  background: linear-gradient(135deg, #FFD34D, #FFB300);
  color: #221A00;
  border-color: transparent;
  font-weight: 600;
}
.mini {
  font-size: 26rpx;
  padding: 0 18rpx;
}
.quiz {
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
}
.ref {
  margin-top: 8rpx;
  background: rgba(255, 197, 49, 0.08);
  border: 1rpx solid rgba(255, 197, 49, 0.12);
  border-radius: 16rpx;
  padding: 12rpx;
  color: #E8DFC8;
}
